{
  "format": "swatch.ui_defaults/v1",
  "_doc": "First-run + Reset-to-defaults source of truth for the two browser tools. Edit this file to change the initial state every user sees on a fresh install. The current per-user state lives in browser localStorage (key cmykUIState_v1 / cmykUIState3d_v1) and is independent of this file.",

  "cmyk_explorer": {
    "step": 10,
    "cell_size": 48,
    "view_mode": "grid",
    "sort_mode": "hue",
    "k_tier": 3,
    "named_filter": "all",
    "name_tolerance": 0,
    "wcag_aa": false,
    "wcag_aaa": false,
    "white_text_only": false,
    "black_text_only": false,
    "search": "",
    "cmyk_range": { "c": [0,100], "m": [0,100], "y": [0,100], "k": [0,100] },
    "tac_max": 400,
    "default_profile_match": "FOGRA39",
    "active_palette_id": null,
    "corpora_prefs": {
      "jpn":  { "display": "primary", "anchor": "hex" },
      "html": { "display": "primary", "anchor": "hex" }
    }
  },

  "3d_explorer": {
    "cell_size": 48,
    "view_mode": "grid",
    "sort_mode": "safety",
    "k_tier": 3,
    "named_filter": "all",
    "name_tolerance": 0,
    "wcag_aa": false,
    "wcag_aaa": false,
    "white_text_only": false,
    "black_text_only": false,
    "search": "",
    "delta_e_max": 2.0,
    "default_library_match": "FOGRA39",
    "active_palette_id": null,
    "corpora_prefs": {
      "jpn":  { "display": "primary", "anchor": "hex" },
      "html": { "display": "primary", "anchor": "hex" }
    }
  }
}
